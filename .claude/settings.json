{
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jignesh/Learning/projects/mcp-servers/.claude/scripts/validate-docker.sh"
          },
          {
            "type": "command",
            "command": "/Users/jignesh/Learning/projects/mcp-servers/.claude/scripts/prevent-secrets.sh"
          },
          {
            "type": "command",
            "command": "/Users/jignesh/Learning/projects/mcp-servers/.claude/scripts/validate-rm.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(node dist/index.js)",
      "Bash(curl -s http://localhost:3002/health)",
      "Bash(jq)",
      "Bash(curl -s -X POST http://localhost:3002/mcp -H 'Content-Type: application/json' -d '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\",\"params\":{}}')",
      "Bash(curl -s -X POST http://localhost:3002/mcp -H 'Content-Type: application/json' -H 'Accept: application/json, text/event-stream' -d '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\",\"params\":{}}')",
      "Bash(curl *)",
      "Bash(npm install *)",
      "Bash(npm ls *)",
      "Bash(npm audit *)",
      "Bash(git init *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(chmod +x *)",
      "WebSearch",
      "mcp__ddg-search__ddg_search",
      "mcp__ddg-search__ddg_instant_answer"
    ]
  }
}