# ── MCP Hub Environment ─────────────────────────────────────────────

# Node environment
NODE_ENV=development
LOG_LEVEL=info

# ── DuckDuckGo Search ───────────────────────────────────────────────
# No API key required — works out of the box
DUCKDUCKGO_SEARCH_PORT=3002
DUCKDUCKGO_SEARCH_MAX_RESULTS=10
DUCKDUCKGO_TIMEOUT_MS=10000

# ── Google Search (optional) ───────────────────────────────────────
# GOOGLE_API_KEY=your_api_key_here
# GOOGLE_CSE_ID=your_cse_id_here
# GOOGLE_SEARCH_PORT=3001
# GOOGLE_SEARCH_MAX_RESULTS=10

# ── GitHub (optional) ───────────────────────────────────────────────
# GITHUB_TOKEN=your_github_token
# GITHUB_PORT=3003

# ── AWS Deployment ─────────────────────────────────────────────────
# GITHUB_REPO=your-org/mcp-hub
# AWS_HOST=your-hostname.com