# ── MCP Hub Environment ─────────────────────────────────────────────

# Node environment
NODE_ENV=development
LOG_LEVEL=info

# ── Google Search (optional) ───────────────────────────────────────
# GOOGLE_API_KEY=your_api_key_here
# GOOGLE_CSE_ID=your_cse_id_here
# GOOGLE_SEARCH_PORT=3001
# GOOGLE_SEARCH_MAX_RESULTS=10

# ── DuckDuckGo Search ───────────────────────────────────────────────
# No API key required — works out of the box
DDG_PORT=3002
DDG_MAX_RESULTS=10
DDG_TIMEOUT_MS=10000
# Rate limiting and caching
DDG_RATE_LIMIT_PER_MINUTE=10
DDG_CACHE_TTL_SECONDS=300

# ── Browser ───────────────────────────────────────────────────────────
BROWSER_PORT=3003
BROWSER_MAX_CONTEXTS=3
BROWSER_CONTEXT_TIMEOUT=30000
BROWSER_NAV_TIMEOUT=15000
BROWSER_TIMEOUT_MS=10000

# ── Filesystem ──────────────────────────────────────────────────────
FILESYSTEM_PORT=3004
FILESYSTEM_ALLOWED_PATHS=~/Learning/projects/mcp-servers
FILESYSTEM_MAX_FILE_SIZE=1048576
FILESYSTEM_MAX_FILES_LISTED=100
# ── Fetch ─────────────────────────────────────────────────────────────
FETCH_PORT=3005
FETCH_TIMEOUT_MS=30000
FETCH_MAX_CONTENT_LENGTH=1048576
FETCH_MAX_URL_LENGTH=2048
FETCH_USER_AGENT=MCP-Fetch-Server/1.0

# ── Memory ──────────────────────────────────────────────────────────
MEMORY_PORT=3006
MEMORY_DB_PATH=~/.mcp-servers/memory.db
MEMORY_NAMESPACE=default
MEMORY_MAX_ENTITY_COUNT=10000
MEMORY_MAX_RELATION_COUNT=50000
MEMORY_MAX_OBSERVATION_COUNT=100000

# ── Docker ──────────────────────────────────────────────────────────
DOCKER_PORT=3007
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_API_VERSION=v1.47
# Per-request timeout to the Docker Engine API (ms)
DOCKER_TIMEOUT_MS=10000
# Image build timeout (ms)
DOCKER_BUILD_TIMEOUT_MS=600000
# TTL for cached read-only results: lists, inspects, system info/df (seconds)
DOCKER_CACHE_TTL_SECONDS=30
# Per-client HTTP rate limit, HTTP transport only (requests/minute)
DOCKER_RATE_LIMIT_PER_MINUTE=120
# Max tool output size before truncation (bytes)
DOCKER_MAX_OUTPUT_BYTES=65536

# ── GitHub (optional) ───────────────────────────────────────────────
# GITHUB_TOKEN=your_github_token
# GITHUB_PORT=3007

# ── AWS Deployment ─────────────────────────────────────────────────
# GITHUB_REPO=your-org/mcp-hub
# AWS_HOST=your-hostname.com