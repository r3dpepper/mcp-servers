# ── Filesystem MCP Server ───────────────────────────────────────────────
# No API key required — provides read/write access to whitelisted directories

# Server settings
FILESYSTEM_PORT=3004
# Filesystem access settings
FILESYSTEM_ALLOWED_PATHS=/tmp
FILESYSTEM_MAX_FILE_SIZE=1048576
FILESYSTEM_MAX_FILES_LISTED=100
# General settings
TRANSPORT=http
NODE_ENV=development
LOG_LEVEL=info