# ── Browser MCP Server ───────────────────────────────────────────────
# No API key required — uses local browser automation

# Server settings
BROWSER_PORT=3003
# Browser automation settings
BROWSER_MAX_CONTEXTS=3
BROWSER_CONTEXT_TIMEOUT=30000
BROWSER_NAV_TIMEOUT=15000
# Domain restrictions (comma-separated, empty = all allowed)
BROWSER_ALLOWED_DOMAINS=
BROWSER_BLOCKED_DOMAINS=
BROWSER_TIMEOUT_MS=10000
# General settings
TRANSPORT=http
NODE_ENV=development
LOG_LEVEL=info
BROWSER_HEADLESS=false