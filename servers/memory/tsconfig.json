{
    "compilerOptions": {
      "target": "ES2022",
      "module": "ESNext",
      "moduleResolution": "bundler",
      "rootDir": "src",
      "outDir": "dist",
      "strict": false,
      "skipLibCheck": true,
      "sourceMap": true,
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "resolveJsonModule": true
    },
    "ts-node": {
      "esm": true
    },
    "include": ["./src/**/*.ts", "./src/**/*.js"],
    "exclude": ["node_modules", "dist"]
  }