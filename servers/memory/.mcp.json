{
  "name": "memory",
  "version": "1.0.0",
  "description": "MCP server for memory management and network operations",
  "commands": [
    {
      "command": "npm",
      "args": ["run", "dev"]
    }
  ],
  "env": {
    "PORT": "3006",
    "NODE_ENV": "development",
    "LOG_LEVEL": "info",
    "MEMORY_PORT": "3006",
    "TRANSPORT": "http"
  },
  "stdio": false
}